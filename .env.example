# Copie para .env em cada PC. O .env nunca vai para o Git.

# ===== Banco (Postgres no seu PC) =====
DATABASE_URL=postgres://garimpo:TROQUE_A_SENHA@localhost:5432/garimpo
# Só na Vercel (docs/deploy.md): DATABASE_URL é o pooler do Supabase em modo transação (porta 6543) e o tempo real
# (LISTEN) usa o pooler em modo sessão (porta 5432). No PC do worker não precisa: lá o DATABASE_URL já é o de sessão.
# DATABASE_LISTEN_URL=

# ===== Papéis deste PC =====
# Hoje (11.11): tudo num PC -> listen,collect,verify,ai (listen = Telegram)
WORKER_ROLES=collect,verify,ai
# 1 = ao ligar, reclassifica as ofertas de 7 dias com as regras atuais (use depois de mudar o parser ou config/alvos.ts).
# Desligado por padrão: no Supabase leva horas e segura o Telegram.
# REMATCH_AO_LIGAR=1

# ===== Telegram (Escuta, só leitura) =====
# api_id e api_hash vêm de my.telegram.org. A sessão é gravada no primeiro login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ===== IA =====
# claude-cli (teste, pela assinatura) | anthropic-api | ollama
AI_PROVIDER=claude-cli
# Modelo único em qualquer provedor.
AI_MODEL=claude-haiku-5-5
# Trava do claude-cli (ponto de partida; ajuste olhando o medidor).
AI_MAX_CHAMADAS_DIA=300

# claude-cli: gere com `claude setup-token` no PC com o papel ai.
CLAUDE_CODE_OAUTH_TOKEN=

# anthropic-api: só quando AI_PROVIDER=anthropic-api.
# O worker remove esta variável do ambiente do `claude -p`, senão ela vence a assinatura.
ANTHROPIC_API_KEY=

# ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Porta do site (Vitrine). Se estiver ocupada, o app usa a próxima livre e avisa.
PORT=3333


# Login (better-auth). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
# Entrar com Google (Google Cloud Console > Credenciais > ID do cliente OAuth). Vazio = botão escondido.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

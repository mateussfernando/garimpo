# Copie para .env em cada PC. O .env nunca vai para o Git.

# ===== Banco (mesmo banco nos dois PCs) =====
# PC 16 GB: localhost. PC 8 GB: o IP do PC de 16 GB na rede local.
DATABASE_URL=postgres://garimpo:TROQUE_A_SENHA@localhost:5432/garimpo

# ===== Papéis deste PC =====
# Hoje (11.11): tudo num PC -> listen,collect,verify,ai (listen = Telegram)
# Depois do 11.11: PC 16 GB listen,collect,verify | PC 8 GB verify,ai
WORKER_ROLES=collect,verify,ai

# ===== Telegram (Escuta, só leitura) =====
# api_id e api_hash vêm de my.telegram.org. A sessão é gravada no primeiro login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ===== IA =====
# claude-cli (teste, pela assinatura) | anthropic-api | ollama
AI_PROVIDER=claude-cli
# Modelo único em qualquer provedor.
AI_MODEL=claude-haiku-5-5
# Trava do claude-cli (ponto de partida; ajuste olhando o medidor).
AI_MAX_CHAMADAS_DIA=300

# claude-cli: gere com `claude setup-token` no PC com o papel ai.
CLAUDE_CODE_OAUTH_TOKEN=

# anthropic-api: só quando AI_PROVIDER=anthropic-api.
# O worker remove esta variável do ambiente do `claude -p`, senão ela vence a assinatura.
ANTHROPIC_API_KEY=

# ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

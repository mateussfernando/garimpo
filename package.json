{
  "name": "garimpo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"node scripts/web.mjs dev\" \"tsx watch worker/index.ts\"",
    "dev:web": "node scripts/web.mjs dev",
    "worker": "tsx watch worker/index.ts",
    "worker:run": "tsx worker/index.ts",
    "build": "next build",
    "start": "node scripts/web.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fontes:debug": "tsx worker/collect/debug.ts",
    "telegram:login": "tsx worker/ingest/telegram-login.ts",
    "vitrines:debug": "tsx worker/collect/vitrines-debug.ts",
    "insights": "tsx worker/ai/terminal.ts",
    "ia:insights": "tsx worker/ai/terminal.ts",
    "simular": "tsx worker/dev/simular.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:travas": "node scripts/db-travas.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:copiar-supabase": "node scripts/supabase-copiar.mjs",
    "postinstall": "prisma generate",
    "admin:criar": "tsx scripts/admin-criar.ts",
    "precos:reprocessar": "tsx scripts/reprocessar-precos.ts",
    "lojas:resolver": "tsx scripts/resolver-lojas.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.27",
    "dotenv": "^18.0.10",
    "geist": "^1.9.2",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AiUsage {
  id           Int      @id @default(autoincrement())
  provider     String
  model        String
  purpose      String
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  ok           Boolean
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_usage")
}

model AlvoRef {
  alvoId             Int      @map("alvo_id")
  bandKey            String   @map("band_key")
  label              String
  medianCents        Int?     @map("median_cents")
  targetCents        Int?     @map("target_cents")
  ceilingCents       Int?     @map("ceiling_cents")
  n                  Int      @default(0)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  manualTargetCents  Int?     @map("manual_target_cents")
  manualCeilingCents Int?     @map("manual_ceiling_cents")
  alvo               Alvo     @relation(fields: [alvoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alvo_refs_alvo_id_alvos_id_fk")

  @@id([alvoId, bandKey], map: "alvo_refs_alvo_id_band_key_pk")
  @@map("alvo_refs")
}

model Alvo {
  id           Int          @id @default(autoincrement())
  slug         String
  name         String
  terms        Json
  exclusions   Json
  targetCents  Int?         @map("target_cents")
  ceilingCents Int?         @map("ceiling_cents")
  /// Ligado (pega ofertas) ou desligado na tela Alvos. Era "active".
  isActive     Boolean      @default(true) @map("is_active")
  origin       String       @default("seed")
  editedAt     DateTime?    @map("edited_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)
  /// Dono do Alvo: cada usuário tem os seus. Vazio = Alvo de antes das contas (o admin assume com `pnpm admin:criar`).
  ownerId      Int?         @map("owner_id")
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  alvoRefs     AlvoRef[]
  marketObs    MarketObs[]
  /// Classificação do sistema (os Alvos de quem gerencia as fontes): mercado, coleta e IA.
  offers       Offer[]
  ofertasAlvo  OfertaAlvo[]

  @@unique([ownerId, slug], map: "alvos_dono_slug")
  @@map("alvos")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  key           String   @unique(map: "coupons_key_unique")
  store         String?
  code          String?
  title         String
  discountKind  String?  @map("discount_kind")
  discountValue Int?     @map("discount_value")
  capCents      Int?     @map("cap_cents")
  minCents      Int?     @map("min_cents")
  conditions    Json     @default("[]")
  url           String?
  postUrl       String?  @map("post_url")
  offerIds      Json     @default("[]") @map("offer_ids")
  sourceNames   Json     @default("[]") @map("source_names")
  forProduct    String?  @map("for_product")
  /// Aparece na tela Cupons. false = escondido para todos (era "hidden", com o valor ao contrário).
  isActive      Boolean  @default(true) @map("is_active")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@map("coupons")
}

model Event {
  id      Int      @id @default(autoincrement())
  type    String
  offerId Int?     @map("offer_id")
  title   String
  detail  Json?
  at      DateTime @default(now()) @db.Timestamptz(6)
  /// Para quem é o acontecimento (Alvo dele: oferta nova, preço, esgotou, Alvo atingido). Vazio = do sistema (canal novo).
  userId  Int?     @map("user_id")
  offer   Offer?   @relation(fields: [offerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "events_offer_id_offers_id_fk")
  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, id])
  @@map("events")
}

model Insight {
  id        Int      @id @default(autoincrement())
  produtoId Int      @map("produto_id")
  periodo   DateTime @db.Date
  hashDados String   @map("hash_dados")
  provedor  String
  modelo    String
  insight   Json
  geradoEm  DateTime @default(now()) @map("gerado_em") @db.Timestamptz(6)
  product   Product  @relation(fields: [produtoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "insights_produto_id_products_id_fk")

  @@unique([produtoId, periodo, hashDados], map: "insights_produto_periodo_hash")
  @@map("insights")
}

model Invite {
  link        String   @id
  kind        String
  mentions    Int      @default(1)
  fromSource  String?  @map("from_source")
  dismissed   Boolean  @default(false)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@map("invites")
}

model MarketObs {
  store          String
  code           String
  alvoId         Int      @map("alvo_id")
  bandKey        String   @map("band_key")
  title          String
  priceCardCents Int      @map("price_card_cents")
  seenAt         DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)
  alvo           Alvo     @relation(fields: [alvoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "market_obs_alvo_id_alvos_id_fk")

  @@id([store, code], map: "market_obs_store_code_pk")
  @@map("market_obs")
}

model OfferAnalysis {
  offerId    Int      @id @map("offer_id")
  hash       String
  verdict    String
  score      Int
  confidence String
  summary    String
  pros       Json     @default("[]")
  cons       Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "offer_analyses_offer_id_offers_id_fk")

  @@map("offer_analyses")
}

model Offer {
  id               Int             @id @default(autoincrement())
  rawMessageId     Int             @unique(map: "offers_raw_message") @map("raw_message_id")
  sourceId         Int             @map("source_id")
  productId        Int?            @map("product_id")
  alvoId           Int?            @map("alvo_id")
  title            String
  store            String?
  url              String?
  imageUrl         String?         @map("image_url")
  priceCardCents   Int?            @map("price_card_cents")
  priceBasis       String?         @map("price_basis")
  installments     Int?
  installmentCents Int?            @map("installment_cents")
  interest         Boolean?
  cashCents        Int?            @map("cash_cents")
  listPriceCents   Int?            @map("list_price_cents")
  /// Mínimo e máximo de referência que a página do Promobit traz para a oferta (referencePrices); vazio = fonte sem isso.
  refMinCents      Int?            @map("ref_min_cents")
  refMaxCents      Int?            @map("ref_max_cents")
  /// Curtidas da oferta na comunidade (Promobit offerLikes); entra no calor social (S) da nota.
  curtidas         Int?
  shippingCents    Int?            @map("shipping_cents")
  freeShipping     Boolean?        @map("free_shipping")
  coupon           String?
  verifyStatus     String          @default("pendente") @map("verify_status")
  verifyNote       String?         @map("verify_note")
  verifiedAt       DateTime?       @map("verified_at") @db.Timestamptz(6)
  nota             Int?
  notaParts        Json?           @map("nota_parts")
  watched          Boolean         @default(false)
  dismissed        Boolean         @default(false)
  snoozedUntil     DateTime?       @map("snoozed_until") @db.Timestamptz(6)
  specs            Json?
  bandKey          String?         @map("band_key")
  available        Boolean?
  extra            Json?
  hitAt            DateTime?       @map("hit_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  kind             String          @default("produto")
  category         String?
  categorySource   String?         @map("category_source")
  /// Na Vitrine de todos. false = tirada por um admin (spam, preço errado); a oferta e o histórico ficam.
  isActive         Boolean         @default(true) @map("is_active")
  // watched, dismissed, snoozed_until e hit_at acima são de antes das contas: ficam como estavam.
  // Hoje cada usuário tem os seus em oferta_usuario e oferta_alvo.
  events           Event[]
  ofertasAlvo      OfertaAlvo[]
  ofertasUsuario   OfertaUsuario[]
  analysis         OfferAnalysis?
  alvo             Alvo?           @relation(fields: [alvoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "offers_alvo_id_alvos_id_fk")
  product          Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "offers_product_id_products_id_fk")
  rawMessage       RawMessage      @relation(fields: [rawMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "offers_raw_message_id_raw_messages_id_fk")
  source           Source          @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "offers_source_id_sources_id_fk")

  @@map("offers")
}

model PricePoint {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  priceCardCents Int?     @map("price_card_cents")
  cashCents      Int?     @map("cash_cents")
  installments   Int?
  interest       Boolean?
  shippingCents  Int?     @map("shipping_cents")
  freeShipping   Boolean? @map("free_shipping")
  imageUrl       String?  @map("image_url")
  origin         String
  observedAt     DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "price_points_product_id_products_id_fk")

  @@map("price_points")
}

model Product {
  id             Int          @id @default(autoincrement())
  store          String
  storeProductId String       @map("store_product_id")
  canonicalUrl   String       @map("canonical_url")
  title          String?
  imageUrl       String?      @map("image_url")
  /// Produto na Vitrine. false = um admin tirou o produto (todas as ofertas dele, de todas as lojas); o histórico fica.
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  insights       Insight[]
  offers         Offer[]
  pricePoints    PricePoint[]

  @@unique([store, storeProductId], map: "products_store_id")
  @@map("products")
}

model RawMessage {
  id          Int      @id @default(autoincrement())
  sourceId    Int      @map("source_id")
  externalId  String   @map("external_id")
  text        String
  url         String?
  outboundUrl String?  @map("outbound_url")
  imageUrl    String?  @map("image_url")
  seenAt      DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)
  offer       Offer?
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "raw_messages_source_id_sources_id_fk")

  @@unique([sourceId, externalId], map: "raw_messages_source_external")
  @@map("raw_messages")
}

model Source {
  id            Int          @id @default(autoincrement())
  slug          String       @unique(map: "sources_slug_unique")
  kind          String
  name          String
  url           String
  /// Fonte ligada (é lida) ou desligada na tela Fontes. Era "enabled".
  isActive      Boolean      @default(true) @map("is_active")
  status        String       @default("ok")
  statusNote    String?      @map("status_note")
  decision      String?
  stats         Json?
  lastMessageAt DateTime?    @map("last_message_at") @db.Timestamptz(6)
  lastRunAt     DateTime?    @map("last_run_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  config        Json?
  origin        String       @default("codigo")
  intervalMin   Int?         @map("interval_min")
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  offers        Offer[]
  rawMessages   RawMessage[]

  @@map("sources")
}

model StoreState {
  slug       String    @id
  /// A loja é conferida. false = pausada por você na tela Lojas (era "paused_by_user", com o valor ao contrário).
  isActive   Boolean   @default(true) @map("is_active")
  pauseUntil DateTime? @map("pause_until") @db.Timestamptz(6)
  pauseNote  String?   @map("pause_note")
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("store_state")
}

model WorkerState {
  id        String   @id
  beatAt    DateTime @default(now()) @map("beat_at") @db.Timestamptz(6)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  roles     String   @default("")

  @@map("worker_state")
}

// ---------- Contas (better-auth). A senha fica em Account.password, com hash bcrypt (bcryptjs, custo 12). ----------

model User {
  id             Int             @id @default(autoincrement())
  /// O id de texto que o login usava antes dos ids numéricos (23/11/2026). Só consulta; nada usa.
  idAntigo       String?         @unique @map("id_antigo")
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false) @map("email_verified")
  image          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions       Session[]
  accounts       Account[]
  /// Cargo do usuário. Vazio = o cargo padrão (o de quem se cadastra). Só um admin muda; o cadastro nunca escolhe.
  cargoId        Int?            @map("cargo_id")
  cargo          Cargo?          @relation(fields: [cargoId], references: [id])
  /// Conta ativa. Desativada (só um admin muda, na tela Usuários): não entra, não usa a API e os Alvos dela param. Nada é apagado.
  isActive       Boolean         @default(true) @map("is_active")
  /// Preço em destaque nos cards: "cartao" (padrão do app) ou "pix". Vazio = ainda não escolheu (o app pergunta).
  precoPreferido String?         @map("preco_preferido")
  alvos          Alvo[]
  ofertasAlvo    OfertaAlvo[]
  ofertasUsuario OfertaUsuario[]
  events         Event[]

  @@map("usuarios")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessoes")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("contas")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verificacoes")
}

/// Limite de tentativas do login (better-auth), no banco para valer também na Vercel (várias instâncias).
model RateLimit {
  id          Int    @id @default(autoincrement())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("limites_de_acesso")
}

// ---------- Cargos e permissões. Cargo novo é uma linha; as permissões são as que o código conhece (src/config/permissoes.ts). ----------

model Cargo {
  id         Int              @id @default(autoincrement())
  slug       String           @unique
  nome       String
  descricao  String?
  /// Tem todas as permissões, sempre (o admin). Garante que ninguém tranca o app sem administrador.
  todas      Boolean          @default(false)
  /// Cargo de quem se cadastra (só um).
  padrao     Boolean          @default(false)
  /// Cargo do sistema (admin e usuário): não se apaga.
  sistema    Boolean          @default(false)
  /// Cargo ativo. Desativado: não aparece para escolher e quem está nele fica com as permissões do cargo padrão.
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissoes CargoPermissao[]
  usuarios   User[]

  @@map("cargos")
}

model Permissao {
  slug      String           @id
  descricao String
  cargos    CargoPermissao[]

  @@map("permissoes")
}

model CargoPermissao {
  cargoId       Int       @map("cargo_id")
  permissaoSlug String    @map("permissao_slug")
  cargo         Cargo     @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  permissao     Permissao @relation(fields: [permissaoSlug], references: [slug], onDelete: Cascade)

  @@id([cargoId, permissaoSlug])
  @@map("cargo_permissoes")
}

// ---------- O que cada oferta é para cada usuário (Fase 6 do deploy-v2). ----------

/// A oferta nos Alvos de um usuário: o Alvo dele que ela pegou, a faixa, a nota com o preço-alvo dele e quando virou "Alvo atingido".
model OfertaAlvo {
  offerId   Int       @map("offer_id")
  userId    Int       @map("user_id")
  /// Vazio = deixou de bater com os Alvos dele (o histórico do "Alvo atingido" fica).
  alvoId    Int?      @map("alvo_id")
  bandKey   String?   @map("band_key")
  nota      Int?
  notaParts Json?     @map("nota_parts")
  hitAt     DateTime? @map("hit_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  offer     Offer     @relation(fields: [offerId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  alvo      Alvo?     @relation(fields: [alvoId], references: [id])

  @@id([offerId, userId])
  @@index([userId, alvoId])
  @@index([alvoId, bandKey])
  @@map("oferta_alvo")
}

/// Marcações de cada usuário numa oferta: vigiar, descartar e soneca da War Room.
model OfertaUsuario {
  userId       Int       @map("user_id")
  offerId      Int       @map("offer_id")
  watched      Boolean   @default(false)
  dismissed    Boolean   @default(false)
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id])
  offer        Offer     @relation(fields: [offerId], references: [id])

  @@id([userId, offerId])
  @@index([offerId])
  @@map("oferta_usuario")
}

/// Retrato da nota quando a IA analisa uma oferta: o que o algoritmo e a IA disseram e os preços da hora. Hoje esses
/// valores se sobrescrevem e se perdem; com o retrato dá para ver depois quem acertou (pnpm notas:calibrar). Só acrescenta.
model NotaRegistro {
  id               Int      @id @default(autoincrement())
  offerId          Int      @map("offer_id")
  productId        Int?     @map("product_id")
  registradoEm     DateTime @default(now()) @map("registrado_em") @db.Timestamptz(6)
  /// Nota do algoritmo (0 a 100); vazio = não opinou (sem preço de referência).
  notaAlgoritmo    Int?     @map("nota_algoritmo")
  /// Fração do peso dos sinais do algoritmo que era conhecida (0 a 1).
  baseAlgoritmo    Float?   @map("base_algoritmo")
  notaIa           Int      @map("nota_ia")
  confiancaIa      String   @map("confianca_ia")
  vereditoIa       String   @map("veredito_ia")
  precoCartaoCents Int?     @map("preco_cartao_cents")
  precoPixCents    Int?     @map("preco_pix_cents")

  @@index([offerId])
  @@index([productId, registradoEm])
  @@map("nota_registro")
}

/// "Essa nota fez sentido?": o 👍 (1) ou 👎 (-1) de cada conta numa oferta, com a nota e o preço que estavam na tela.
/// É o gabarito mais direto da nota. Um voto por conta e oferta (trocável).
model NotaFeedback {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  offerId      Int      @map("offer_id")
  voto         Int
  notaMostrada Float?   @map("nota_mostrada")
  preco        String
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([userId, offerId], map: "nota_feedback_conta_oferta")
  @@index([offerId])
  @@map("nota_feedback")
}

/// Quando uma conta clica em Comprar (só conta, nunca visitante): sinal de que a oferta valeu a pena para a pessoa.
model CliqueComprar {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  offerId  Int      @map("offer_id")
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([userId, criadoEm])
  @@index([offerId])
  @@map("cliques_comprar")
}

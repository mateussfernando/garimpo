{
  "name": "garimpo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"next dev -H 0.0.0.0\" \"tsx watch worker/index.ts\"",
    "dev:web": "next dev -H 0.0.0.0",
    "worker": "tsx watch worker/index.ts",
    "worker:run": "tsx worker/index.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "fontes:debug": "tsx worker/collect/debug.ts",
    "telegram:login": "tsx worker/ingest/telegram-login.ts",
    "vitrines:debug": "tsx worker/collect/vitrines-debug.ts",
    "ia:insights": "tsx worker/ai/run-once.ts",
    "simular": "tsx worker/dev/simular.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
